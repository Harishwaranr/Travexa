# Copy this file to .env (same folder as package.json) and fill in your key.
# .env is gitignored, so it never leaves your machine.
#
#   1. Get a key: https://foursquare.com/developers/  (Places API)
#   2. cp .env.example .env   — then paste the key below
#   3. npm run dev            — open http://localhost:3001

FOURSQUARE_API_KEY=

# Optional. server/index.js defaults to 3001.
# PORT=3001
