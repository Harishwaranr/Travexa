# Copy to .env (same folder as package.json), then fill in.
# .env is gitignored — never commit it, never paste these values into chat.

# ---------------------------------------------------------------- places
# Foursquare Places — Service Key for the new Places API.
# https://foursquare.com/developers/
FOURSQUARE_API_KEY=

# Premium fields (rating, price, photos, hours) consume Foursquare credits.
# Leave unset to stay on the free field set; the server falls back
# automatically if credits run out.
# FOURSQUARE_PREMIUM=true

# -------------------------------------------------------------------- ai
# Gemini — AI Studio API key. Both the older "AIza..." and the newer "AQ...."
# formats work; both are sent as x-goog-api-key.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Primary model. Defaults to gemini-3.5-flash, with gemini-flash-latest as an
# automatic fallback when the primary is rate-limited or overloaded.
# GEMINI_MODEL=gemini-3.5-flash

# -------------------------------------------------------------- database
# Postgres connection string.
#   local:  postgresql://postgres:PASSWORD@localhost:5432/travexa
#   hosted: the "connection string" from Supabase / Neon / RDS
DATABASE_URL=

# ------------------------------------------------------------------ auth
# Signs guide session tokens. Any random string of 32+ characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Where identity documents are written. MUST be outside this project folder
# so they are never served or committed. Defaults to ../travexa-private-uploads
# DOC_STORAGE_DIR=

# -------------------------------------------------------------- payments
# Razorpay. KEY_ID is publishable (Checkout needs it in the browser);
# KEY_SECRET must stay server-side. https://dashboard.razorpay.com
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Set when you create the webhook in the Razorpay dashboard.
# Endpoint: POST https://YOUR_DOMAIN/api/payments/webhook
# Events:   payment.captured, payment.failed, refund.processed
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------ misc
# PORT=3001
